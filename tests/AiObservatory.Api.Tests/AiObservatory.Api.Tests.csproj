<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="FixPortal.CodeStyle.ArchRules" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="NodaTime.Testing" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="TngTech.ArchUnitNET.xUnitV3" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AiObservatory.Api\AiObservatory.Api.csproj" />
    <!--
      Aliased. Once AiObservatory.Ingest gained ASP.NET Core (to answer App Service's
      startup probe) its top-level entry point became a public global-namespace Program,
      the same shape as the API's own `public partial class Program`. This project
      references BOTH assemblies, so plain references make every `WebApplicationFactory
      <Program>` fail with CS0433 "the type exists in both". The alias scopes Ingest's
      types to `ingest::` so only the API's Program is reachable as bare `Program`.
      Confined to the test project on purpose: neither production entry point should be
      reshaped to work around a clash that exists only where both are referenced.
      See ArchitectureTests, the only consumer.
    -->
    <ProjectReference Include="..\..\src\AiObservatory.Ingest\AiObservatory.Ingest.csproj" Aliases="ingest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\PostgresTestAssemblyFixture.cs" Link="PostgresTestAssemblyFixture.cs" />
  </ItemGroup>

</Project>
